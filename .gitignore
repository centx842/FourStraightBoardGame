# Ignore Python virtual environments
.venv/

# Ignore Python bytecode
__pycache__/
*.py[cod]
*.pyo

# Ignore test artifacts
tests/__pycache__/
Resources/__pycache__/

# Ignore editor/IDE-specific files
.idea/
*.swp
temp_auto_push.bat
*.swo

# Ignore OS-specific files
.DS_Store
Thumbs.db

# Ignore logs and coverage files
*.log
*.coverage
coverage.xml
htmlcov/

# Build files
build 
dist.gitignore
branch_structure.json
